# Copy to .env and fill in real values. Never commit .env.

# --- Environment -------------------------------------------------------------
# development | staging | production. Anything but "development" refuses to start with a weak JWT_SECRET.
APP_ENV=development

# --- Databases ---------------------------------------------------------------
# Platform's own read/write DB (incidents, evidence, approvals, users). Apply schema with: alembic upgrade head
APP_DB_URL=postgresql+asyncpg://app_user:changeme@localhost:5432/incident_ai
# Read-only role used ONLY by the Database MCP server when investigating the target application
INVESTIGATION_DB_URL=postgresql+asyncpg://incident_investigator:changeme@localhost:5432/target_app_db

# --- Auth --------------------------------------------------------------------
# Required outside development; >= 32 random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OIDC_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0
OIDC_CLIENT_ID=changeme

# --- CORS --------------------------------------------------------------------
# Explicit origins only, comma-separated or JSON list. "*" is rejected. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Secret manager ----------------------------------------------------------
# vault | azure_keyvault | aws_secrets
SECRET_BACKEND=vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=changeme
AZURE_KEYVAULT_URL=

# --- LLM ---------------------------------------------------------------------
# azure_openai | openai
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=changeme
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
OPENAI_API_KEY=
# Per-incident circuit breaker (USD)
LLM_MAX_COST_PER_INCIDENT_USD=2.00

# --- MCP providers -----------------------------------------------------------
# Local Code MCP: comma-separated repository roots the server may read
ALLOWED_REPOSITORIES=/repos/target
KUBERNETES_API_URL=
KUBERNETES_TOKEN=

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Soft limit marks the run failed; the hard limit must be larger
INVESTIGATION_SOFT_TIME_LIMIT_SECONDS=600
INVESTIGATION_TIME_LIMIT_SECONDS=660
# Broker publish retries before /investigate returns 503
TASK_ENQUEUE_MAX_RETRIES=2

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
# json | console (console is for local development only)
LOG_FORMAT=json
